{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quire Multi WebView Spike",
  "version": "0.0.0",
  "identifier": "life.hato.quire.multiwebviewspike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quire Multi WebView Spike",
        "width": 1200,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
